NODE_ENV=development

# Render provides PORT automatically in production; only needed for local dev.
PORT=5000

MONGODB_URI=mongodb://localhost:27017/green-leaf-gardening

JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CLIENT_URL=http://localhost:5173

# Not used yet — reserved for a future cloud storage provider (see
# STORAGE_PROVIDER below). Local disk storage needs none of these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Product image storage. "local" (default) writes to UPLOAD_DIR on the
# server's own persistent disk — the right choice for BigRock or any normal
# Linux host. Leave UPLOAD_DIR unset for local dev (defaults to ./uploads
# inside the server workspace). In production, point it at a persistent
# directory outside the app's own folder, e.g.
# /home/<cpanel-user>/greenkart_uploads, so uploads survive redeploys.
STORAGE_PROVIDER=local
UPLOAD_DIR=
UPLOAD_BASE_URL=/uploads

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
