# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development

# The hosting platform provides PORT automatically in production; only
# needed for local dev.
PORT=5000

# Public URL of the frontend (used for CORS, canonical/OG links, sitemap).
CLIENT_URL=http://localhost:5173

# Number of reverse-proxy hops in front of Node (Express `trust proxy`).
# Most managed Node hosts (e.g. Hostinger) are a single hop — only change
# this if an extra CDN/load balancer sits in front of the platform's proxy.
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Database (MySQL via Prisma)
# ---------------------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# The production value is provided by whoever configures the Hostinger
# MySQL database — never hardcode host/user/password/db name in code.
DATABASE_URL=mysql://root:root@localhost:3306/greenkart

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---------------------------------------------------------------------------
# Uploads (product images)
# ---------------------------------------------------------------------------
# "local" (default) writes to UPLOAD_DIR on the server's own persistent
# disk. Leave UPLOAD_DIR unset for local dev (defaults to ./uploads inside
# the server workspace). In production, point it at a persistent directory
# outside the app's own deployment folder so uploads survive redeploys —
# the exact path is provided by whoever configures the host.
STORAGE_PROVIDER=local
UPLOAD_DIR=
UPLOAD_BASE_URL=/uploads

# ---------------------------------------------------------------------------
# Razorpay (optional — leave all three unset to run COD-only)
# ---------------------------------------------------------------------------
# Either all three must be set (Pay Online enabled) or none of them
# (COD-only mode); a partial configuration fails fast at boot.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
